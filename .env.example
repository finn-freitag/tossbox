# ---------------------------------------------------------------- required
# Base domain for devices. Create a wildcard DNS record:
#   *.servers.example.com  A  <public IP of this host>
TOSSBOX_BASE_DOMAIN=servers.example.com

# Password of the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me

# Initial admin account (only used when the database has no users yet).
TOSSBOX_ADMIN_USERNAME=admin
TOSSBOX_ADMIN_PASSWORD=change-me-too

# 32 random bytes, hex or base64: `openssl rand -hex 32`. Encrypts device
# passwords and license keys at rest. If empty, a key is generated in the data
# volume (back it up!).
TOSSBOX_SECRET_KEY=

# ---------------------------------------------------------------- dashboard
# Hostname of the dashboard itself. The gateway serves it on 80/443 (TLS via
# Let's Encrypt when TOSSBOX_ACME_EMAIL is set). Leave empty to only use :8080.
TOSSBOX_DASHBOARD_HOST=dashboard.example.com
TOSSBOX_ACME_EMAIL=
TOSSBOX_PUBLIC_URL=https://dashboard.example.com
# UI/API listener (always on; put your own reverse proxy in front if you like).
TOSSBOX_HTTP_LISTEN=:8080

# ---------------------------------------------------------------- nodes
# gRPC listener for node agents and the names/IPs agents use to reach it
# (added to the TLS certificate). TOSSBOX_DASHBOARD_HOST is added automatically.
TOSSBOX_GRPC_LISTEN=:7443
TOSSBOX_GRPC_HOSTS=
# Shown to admins as the agent endpoint (default: <dashboard host>:7443).
TOSSBOX_GRPC_ENDPOINT=

# ---------------------------------------------------------------- gateway
# One port per exposed device service is allocated from this range. The node
# agents listen on the same port numbers.
TOSSBOX_PORT_RANGE=40000-49999
# Name-based routing to device ports 80/443 (empty = off, e.g. if another
# reverse proxy owns 80/443; then use the fallbacks the other way round).
TOSSBOX_GATEWAY_HTTP_LISTEN=:80
TOSSBOX_GATEWAY_HTTPS_LISTEN=:443
# Hosts that are neither devices nor the dashboard are forwarded here (optional).
TOSSBOX_GATEWAY_FALLBACK_HTTP=
TOSSBOX_GATEWAY_FALLBACK_HTTPS=
# Bind address for exposure "public" (default all interfaces).
TOSSBOX_GATEWAY_PUBLIC_ADDRESS=0.0.0.0
# Bind address for exposure "tailscale" (this host's Tailscale IP). Empty = option disabled.
TOSSBOX_GATEWAY_TAILSCALE_ADDRESS=
# New connections per source IP per minute on device ports (0 = off).
TOSSBOX_GATEWAY_RATE_LIMIT=60
# Reverse proxies in front of Tossbox (IPs/CIDRs) whose X-Forwarded-For is
# trusted, e.g. 127.0.0.1,172.16.0.0/12 for Traefik in Docker. Required behind
# a proxy for per-client login rate limiting.
TOSSBOX_TRUSTED_PROXIES=

# ---------------------------------------------------------------- templates
# Comma separated catalog.json URLs or directories with template YAML files.
TOSSBOX_TEMPLATE_SOURCES=https://raw.githubusercontent.com/finn-freitag/tb-templates/main/catalog.json

# ---------------------------------------------------------------- guacamole (optional)
# Start with `docker compose --profile guacamole up -d`. Served at
# guacamole.<base domain> by the gateway.
TOSSBOX_GUACAMOLE_URL=
# 32 hex characters: `openssl rand -hex 16`
TOSSBOX_GUACAMOLE_JSON_SECRET=
# auto | true | false. true if another proxy terminates TLS and forwards the
# Guacamole host to this gateway (fresh Guacamole session per login).
TOSSBOX_GUACAMOLE_LOGIN_HELPER=auto
